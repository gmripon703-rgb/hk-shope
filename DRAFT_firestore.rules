rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'gmripon703@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'category', 'image']) &&
             data.keys().hasOnly(['id', 'title', 'price', 'compareAtPrice', 'rating', 'reviewsCount', 'tag', 'category', 'image', 'description', 'stock', 'salesCount', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 50 &&
             data.image is string && data.image.size() <= 500 &&
             (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0)) &&
             (!('stock' in data) || (data.stock is number && data.stock >= 0)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phone', 'address', 'total', 'status', 'paymentMethod']) &&
             data.keys().hasOnly(['id', 'customerName', 'phone', 'address', 'city', 'subtotal', 'shipping', 'total', 'status', 'paymentMethod', 'notes', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 300 &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['storeName', 'currency', 'shippingFee']) &&
             data.keys().hasOnly(['storeName', 'currency', 'shippingFee', 'freeShippingThreshold', 'phoneSupport', 'emailSupport', 'codNotice']) &&
             data.storeName is string && data.storeName.size() <= 100 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.shippingFee is number && data.shippingFee >= 0;
    }

    // Collections
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == orderId && incoming().status == 'pending';
      allow get, list: if isAdmin();
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId) && isValidSettings(incoming());
    }
  }
}
